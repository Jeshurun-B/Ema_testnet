sor (MAE)', color='#ea580c', edgecolor='black', lw=0.7)\n","    axes[0].axhline(0.0, color='#000000', linestyle='-', lw=1.0)\n","    axes[0].set_title('Panel 1: Out-of-Sample R^2 Score by Symbol & Direction (20 CatBoost Regressors)\\nPositive R^2 = Outperforming Baseline Excursion Means', fontsize=13, fontweight='bold')\n","    axes[0].set_ylabel('R^2 Score', fontsize=11)\n","    axes[0].set_xticks(x_coords)\n","    axes[0].set_xticklabels(plot_labels, fontsize=10, fontweight='bold')\n","    axes[0].legend(loc='upper right', frameon=True, fontsize=10)\n","    axes[0].grid(axis='y', alpha=0.3)\n","\n","    # Panel 2: Spearman Rank Correlation (rho)\n","    rho_p = sym_plot_df[sym_plot_df['target'] == 'target_profit_v1']['oos_spearman_rho'].values\n","    rho_d = sym_plot_df[sym_plot_df['target'] == 'target_danger_v1']['oos_spearman_rho'].values\n","\n","    axes[1].bar(x_coords - width/2, rho_p, width, label='Profit Rank Correlation', color='#10b981', edgecolor='black', lw=0.7)\n","    axes[1].bar(x_coords + width/2, rho_d, width, label='Danger Rank Correlation', color='#f59e0b', edgecolor='black', lw=0.7)\n","    axes[1].axhline(0.0, color='#000000', linestyle='-', lw=1.0)\n","    axes[1].set_title('Panel 2: Out-of-Sample Spearman Rank Correlation (rho)\\nHigh Rank Correlation = Reliable Dynamic Bracket Ordering', fontsize=13, fontweight='bold')\n","    axes[1].set_ylabel('Spearman rho', fontsize=11)\n","    axes[1].set_xticks(x_coords)\n","    axes[1].set_xticklabels(plot_labels, fontsize=10, fontweight='bold')\n","    axes[1].legend(loc='upper right', frameon=True, fontsize=10)\n","    axes[1].grid(axis='y', alpha=0.3)\n","\n","    # Panel 3: Prediction RMSE (%)\n","    rmse_p = sym_plot_df[sym_plot_df['target'] == 'target_profit_v1']['oos_rmse'].values\n","    rmse_d = sym_plot_df[sym_plot_df['target'] == 'target_danger_v1']['oos_rmse'].values\n","\n","    axes[2].bar(x_coords - width/2, rmse_p, width, label='Profit RMSE (%)', color='#0369a1', edgecolor='black', lw=0.7)\n","    axes[2].bar(x_coords + width/2, rmse_d, width, label='Danger RMSE (%)', color='#c2410c', edgecolor='black', lw=0.7)\n","    axes[2].set_title('Panel 3: Out-of-Sample Prediction RMSE (%)\\nTighter Residuals Enable Narrower Stop-Loss Protection', fontsize=13, fontweight='bold')\n","    axes[2].set_ylabel('RMSE (%)', fontsize=11)\n","    axes[2].set_xticks(x_coords)\n","    axes[2].set_xticklabels(plot_labels, fontsize=10, fontweight='bold')\n","    axes[2].legend(loc='upper right', frameon=True, fontsize=10)\n","    axes[2].grid(axis='y', alpha=0.3)\n","\n","    plt.tight_layout()\n","\n","    # Save visual\n","    chart_name = \"Ema_testnet_CatBoost_Regression_Optimization_vertical_barchart.png\"\n","    chart_path = os.path.join(RESULTS_DIR, chart_name)\n","    plt.savefig(chart_path, dpi=150, bbox_inches='tight')\n","    plt.show()\n","    print(f\"Vertical diagnostic figure saved to: {chart_path}\")\n","\n","    # Serialize Master JSON Dictionary\n","    master_results_payload = {\n","        'metadata': {\n","            'description': 'Master Production CatBoost Regressor Suite (4 Global + 20 Symbol Models via 50-Trial Optuna TPE)',\n","            'total_models_trained': len(master_24_df),\n","            'optuna_trials_per_model': N_OPTUNA_TRIALS,\n","            'target_discretization': '98-Bin Quantile Winsorized Capped at P98',\n","            'feature_selection': 'Directional Target-Specific True Tree SHAP-16',\n","            'portfolio_averages': {\n","                'global_mean_r2': round(float(mean_r2_glob), 5),\n","                'global_mean_rho': round(float(mean_rho_glob), 5),\n","                'symbol_mean_r2': round(float(mean_r2_sym), 5),\n","                'symbol_mean_rho': round(float(mean_rho_sym), 5)\n","            },\n","            'timestamp_utc': time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime())\n","        },\n","        'global_models': global_model_summaries,\n","        'per_symbol_models': symbol_models_regis