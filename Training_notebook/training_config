_pct': round(exec_res['actual_mfe_pct'], 2),\n","                'actual_mae_pct': round(exec_res['actual_mae_pct'], 2),\n","                'gross_return_pct': round(exec_res['gross_return_pct'], 2),\n","                'gross_pnl': round(exec_res['gross_pnl'], 2),\n","                'fees_paid': round(exec_res['fees_paid'], 2),\n","                'slippage_cost': round(exec_res['slippage_cost'], 2),\n","                'friction_tax': round(exec_res['friction_tax'], 2),\n","                'net_pnl': round(exec_res['net_pnl'], 2),\n","                'account_equity': round(current_capital, 2),\n","                'drawdown_pct': round(current_dd_pct, 2)\n","            })\n","        else:\n","            trade_log.append({\n","                'trade_id': idx + 1,\n","                'timestamp': row['checked_at_utc'],\n","                'symbol': sym,\n","                'direction': direction,\n","                'status': 'REJECTED',\n","                'gate_combo_tag': decision['gate_combo_tag'],\n","                'rr_ratio': round(decision['rr_ratio'], 2),\n","                'rejection_reason': decision['rejection_reason'],\n","                'outcome': f\"SHADOW_{exec_res['outcome']}\",\n","                'margin_allocated': 0.0,\n","                'leverage': 0.0,\n","                'notional_position': 0.0,\n","                'dynamic_tp_pct': round(exec_res['dynamic_tp_pct'], 2),\n","                'dynamic_sl_pct': round(exec_res['dynamic_sl_pct'], 2),\n","                'actual_mfe_pct': round(exec_res['actual_mfe_pct'], 2),\n","                'actual_mae_pct': round(exec_res['actual_mae_pct'], 2),\n","                'gross_return_pct': round(exec_res['gross_return_pct'], 2),\n","                'gross_pnl': 0.0,\n","                'fees_paid': 0.0,\n","                'slippage_cost': 0.0,\n","                'friction_tax': 0.0,\n","                'net_pnl': 0.0,\n","                'account_equity': round(current_capital, 2),\n"," 