ck\n","    cb_json_path  = os.path.join(REPO_PATH, \"Optimal_hyperparameters\", CB_JSON_NAME)\n","    gru_json_path = os.path.join(REPO_PATH, \"Optimal_hyperparameters\", GRU_JSON_NAME)\n","\n","    if not os.path.exists(cb_json_path) and 'RESULTS_DIR' in globals():\n","        cb_json_path = os.path.join(RESULTS_DIR, CB_JSON_NAME)\n","    if not os.path.exists(gru_json_path) and 'RESULTS_DIR' in globals():\n","        gru_json_path = os.path.join(RESULTS_DIR, GRU_JSON_NAME)\n","\n","    ACTIVE_SYMBOLS = ['BTCUSDT', 'DOGEUSDT', 'ETHUSDT', 'SOLUSDT', 'XRPUSDT']\n","    DIRECTIONS     = ['LONG', 'SHORT']\n","\n","    # 1. Audit CatBoost JSON (24 Models)\n","    cb_audit_passed = True\n","    if not os.path.exists(cb_json_path):\n","        print(f\"  [CatBoost Audit FAILED] Missing file: {CB_JSON_NAME}\")\n","        cb_audit_passed = False\n","    else:\n","        with open(cb_json_path, 'r') as f:\n","            cb_data = json.load(f)\n","\n","        g_models = cb_data.get('global_models', [])\n","        s_models = cb_data.get('per_symbol_models', {})\n","\n","        n_global_cb = len(g_models)\n","        n_symbol_cb = len(s_models)\n","\n","        print(f\"  CatBoost File Found: {os.path.relpath(cb_json_path, PARENT_DIR)}\")\n","        print(f\"    - Global Models Found        : {n_global_cb} / 4\")\n","        print(f\"    - Symbol Models Found        : {n_symbol_cb} / 20\")\n","\n","        if n_global_cb != 4 or n_symbol_cb != 20:\n","            cb_audit_passed = False\n","\n","        # Validate parameter completeness across symbol models\n","        for t_col in ['target_profit_v1', 'target_danger_v1']:\n","            for dir_val in DIRECTIONS:\n","                for sym in ACTIVE_SYMBOLS:\n","                    key = f\"{t_col}__{dir_val}__{sym}\"\n","                    if key not in s_models:\n","                        print(f\"      [Missing Config] {key}\")\n","                        cb_audit_passed = False\n","                    else:\n","