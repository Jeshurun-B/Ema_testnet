       \"\"\"\n","        df_out = df_target.copy()\n","        n_in = len(df_out)\n","\n","        # 1. Target Profit: 98-Bin Quantile Winsorization (Capped at P98)\n","        profit_quantiles = np.linspace(1, 98, 98)\n","        cutoffs_profit   = np.percentile(train_ref['target_profit'].dropna(), profit_quantiles)\n","        p_bin_idx        = np.clip(np.digitize(df_out['target_profit'], bins=cutoffs_profit[:-1]), 0, 97)\n","        df_out['target_profit_v1'] = cutoffs_profit[p_bin_idx]\n","\n","        # 2. Target Danger: 98-Bin Quantile Winsorization (Capped at P98)\n","        danger_quantiles = np.linspace(1, 98, 98)\n","        cutoffs_danger   = np.percentile(train_ref['target_danger'].dropna(), danger_quantiles)\n","        d_bin_idx        = np.clip(np.digitize(df_out['target_danger'], bins=cutoffs_danger[:-1]), 0, 97)\n","        df_out['target_danger_v1'] = cutoffs_danger[d_bin_idx]\n","\n","        # 3. Binary Classification Targets (Train-Referenced Median P50)\n","        median_profit = float(np.percentile(train_ref['target_profit'].dropna(), 50))\n","        median_danger = float(np.percentile(train_ref['target_danger'].dropna(), 50))\n","        \n","        df_out['target_profit_b50'] = (df_out['target_profit'] >= median_profit).astype(int)\n","        df_out['target_danger_b50'] = (df_out['target_danger'] >= median_danger).astype(int)\n","\n","        assert len(df_out) == n_in, f\"construct_v1_targets changed row count: {n_in} -> {len(df_out)}\"\n","        return df_out\n","\n","    # =========================================================================\n","    # STEP 3: Execute Transformation & Update Section A Global Mappings\n","    # =========================================================================\n","    train_long  = construct_v1_targets(train_long,  train_ref=train_long)\n","    train_short = construct_v1_targets(train_short, train_ref=train_short)\n","    oos_long    = construct_v1_targets(oos_long,    train_ref=train_long)\n","    oos_short   = construct_v1_targets(oos_short,   train_ref=train_short)\n","\n","    # Re-register global Section A mappings\n","    direction_train_map = {'LONG': (train_long, feat_set_long), 'SHORT': (train_short, feat_set_short)}\n","    direction_oos_map   = {'LONG': (oos_long, feat_set_long),   'SHORT': (oos_short, feat_set_short)}\n","    CORE_TARGETS = ['target_profit_v1', 'target_danger_v1', 'target_profit_b50', 'target_danger_b50']\n","\n","    print(\"===============================================================================\")\n","    print(\"  SECTION A UPGRADE COMPLETE: 98-BIN QUANTILE WINSORIZED TARGETS LOCKED        \")\n","    print(\"===============================================================================\")\n","    print(f\"LONG  | Profit Bins: {train_long['target_profit_v1'].nunique()} | P98 Cap: {train_long['target_profit_v1'].max():.4f}% | Median P50: {train_long['target_profit'].median():.4f}%\")\n","    print(f\"LONG  | Danger Bins: {train_long['target_danger_v1'].nunique()} | P98 Cap: {train_long['target_danger_v1'].max():.4f}% | Median P50: {train_long['target_danger'].median():.4f}%\")\n","    print(f\"SHORT | Profit Bins: {train_short['target_profit_v1'].nunique()} | P98 Cap: {train_short['target_profit_v1'].max():.4f}% | Median P50: {train_short['target_profit'].median():.4f}%\")\n","    print(f\"SHORT | Danger Bins: {train_short['target_danger_v1'].nunique()} | P98 Cap: {train_short['target_danger_v1'].max():.4f}% | Median P50: {train_short['target_danger'].median():.4f}%\")\n","    print(\"===============================================================================\\n\")"]},{"cell_type":"markdown","id":"308bc034","metadata":{"papermill":{"duration":0.004239,"end_time":"2026-09-06T20:27:01.966491+00:00","exception":false,"start_time":"2026-09-06T20:27:01.962252+00:00","status":"completed"},"tags":[]},"source":["---\n","###  The Optimal hyperparameters tunning rounds "]},{"cell_type":"code","execution_count":4,"id":"0630d9d5","metadata":{"execution":{"iopub.execute_input":"2026-09-06T20:27:01.976067Z","iopub.status.busy":"2026-09-06T20:27:01.975673Z","iopub.status.idle":"2026-09-06T20:27:02.036832Z","shell.execute_reply":"2026-09-06T20:27:02.035785Z"},"jupyter":{"source_hidden":true},"papermill":{"duration":0.068265,"end_time":"2026-09-06T20:27:02.038597+00:00","exception":false,"start_time":"2026-09-06T20:27:01.970332+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\"\"\"\n","====================================================================================================\n","ALGORITHM: Track 1 — CatBoost Continuous Regressor Optimization Suite (24 Models via Optuna TPE)\n","====================================================================================================\n","Purpose:\n","  Optimize, checkpoint, and evaluate exactly 24 CatBoost Continuous Regressors targeting 98-bin\n","  Quantile Winsorized Profit (`target_profit_v1`) and Danger (`target_danger_v1`):\n","    - Tier 1: 4 Global Models (Profit & Danger across LONG and SHORT)\n","    - Tier 2: 20 Per-Symbol Models (5 Coins x 2 Directions x 2 Targets)\n","    - Total: 4 + 20 = 24 Production Models\n","\n","Self-Containment & Kaggle Resilience (Rule 4):\n","  - Completely defines `cv_catboost_leakfree_reg` self-containedly inside this cell so that it\n","    survives kernel restarts and operates independently of prior notebook state.\n","  - Hardware acceleration: Sets `thread_count=-1` in CatBoost to saturate all available Kaggle vCPUs.\n","  - Parallel multi-threading handles 50-trial Optuna sweeps efficiently on CPU.\n","\n","Validation Framework (TimeSeriesSplit, 5 Folds, Gap=50):\n","  - Outer Loop: TimeSeriesSplit(n_splits=5, gap=50) to prevent time-series autocorrelation leakage.\n","  - Inner Split: 85% Chronological Sub-Train for tree growth, 15% Sub-Val for early stopping.\n","  - Fold-Local Scaling: StandardScaler fit strictly on each fold's Sub-Train slice.\n","  - Early Stopping: Tracked on Sub-Val RMSE loss with early_stopping_rounds=30.\n","\n","Optimization Search Space (Optuna Bayesian TPE, 50 Trials per Model):\n","  - depth: int in [4, 8] (Symmetric oblivious tree depth)\n","  - learning_rate: float in [0.015, 0.08] (log-uniform)\n","  - l2_leaf_reg: float in [1.0, 15.0] (log-uniform, leaf shrinkage)\n","  - random_strength: float in [0.2, 2.0] (split score perturbation)\n","  - bagging_temperature: float in [0.0, 1.0] (Bayesian bootstrap intensity)\n","\n","Algorithm Steps:\n","  1. Execution Guard & Environment Validation:\n","     - Set RUN_CATBOOST_OPTUNA_24_MODELS = True.\n","     - Set N_OPTUNA_TRIALS = 50.\n","     - Suppress Optuna verbose info logs to maintain clean notebook output.\n","  2. Define Self-Contained cv_catboost_leakfree_reg Engine:\n","     - Implements 5-fold TimeSeriesSplit(gap=50) with inner 85/15 sub-split.\n","     - Trains CatBoostRegressor with early_stopping_rounds=30.\n","     - Evaluates outer fold test slice: R^2, Spearman rho, RMSE, MAE.\n","     - Returns {metric: (mean, std), 'fold_details': [...]}.\n","  3. Directional True Tree SHAP-16 Extraction on Sub-Train:\n","     - Fit LightGBM on Sub-Train for each target and direction (4 models).\n","     - Extract exact Top 16 stationary features per (target, direction) combination.\n","  4. Tier 1 — 4 Global Directional Models (50-Trial Optuna):\n","     - Run 50-trial Optuna study per combination optimizing CV R^2 + 0.5 * Spearman rho.\n","     - Retrain on pooled Sub-Train with Sub-Val early stopping.\n","     - Save checkpoint as: Ema_testnet_CatBoostRegressor_{target}_{dir}_GLOBAL_models.cbm.\n","     - Evaluate once on untouched OOS partition.\n","  5. Tier 2 — 20 Per-Symbol Dedicated Models (50-Trial Optuna per Coin):\n","     - For each target, direction, and active asset (BTC, DOGE, ETH, SOL, XRP):\n","         * Slice symbol-specific Sub-Train and Sub-Val.\n","         * Run 50-trial Optuna study optimizing coin-specific excursion distributions.\n","         * Retrain on symbol Sub-Train with Sub-Val early stopping.\n","         * Save checkpoint as: Ema_testnet_CatBoostRegressor_{target}_{dir}_{symbol}_models.cbm.\n","         * Evaluate once on untouched symbol OOS slice.\n","  6. Master 24-Model Scoreboard Compilation, Vertical Visuals & JSON Serialization:\n","     - Combine 4 Global + 20 Symbol models into a single 24-row master summary table.\n","     - Render vertical (3, 1) diagnostic figures comparing Global vs. Symbol performance.\n","     - Serialize complete results dictionary to:\n","       RESULTS_DIR/Ema_testnet_CatBoost_Regression_Optimization_results.json.\n","====================================================================================================\n","\"\"\"\n","\n","# =============================================================================\n","# STEP 1: Execution Guard & Environment Setup\n","# =============================================================================\n","RUN_CATBOOST_OPTUNA_24_MODELS = False\n","\n","if RUN_CATBOOST_OPTUNA_24_MODELS:\n","    import os\n","    import copy\n","    import time\n","    import json\n","    import warnings\n","    import optuna\n","    import numpy as np\n","    import pandas as pd\n","    import matplotlib.pyplot as plt\n","    import lightgbm as lgb\n","    import shap\n","    from scipy.stats import spearmanr\n","    from sklearn.model_selection import TimeSeriesSplit\n","    from sklearn.preprocessing import StandardScaler\n","    from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error\n","    from catboost import CatBoostRegressor\n","\n","    # Clean logging and reproducibility\n","    optuna.logging.set_verbosity(optuna.logging.WARNING)\n","    warnings.filterwarnings(\"ignore\", category=UserWarning)\n","    np.random.seed(42)\n","\n","    # Configuration Constants\n","    N_OPTUNA_TRIALS    = 50\n","    REGRESSION_TARGETS = ['target_profit_v1', 'target_danger_v1']\n","    DIRECTIONS         = ['LONG', 'SHORT']\n","    ACTIVE_SYMBOLS     = ['BTCUSDT', 'DOGEUSDT', 'ETHUSDT', 'SOLUSDT', 'XRPUSDT']\n","\n","    print(\"===============================================================================\")\n","    print(\"  TRACK 1: CATBOOST REGRESSOR SUITE (24 MODELS VIA 50-TRIAL OPTUNA TPE)        \")\n","    print(f\"  Trials per Model : {N_OPTUNA_TRIALS} | Total Models: 4 Global + 20 Symbol = 24\")\n","    print(f\"  Checkpoints Path : {MODELS_DIR}                                              \")\n","    print(\"===============================================================================\\n\")\n","\n","    # =========================================================================\n","    # STEP 2: Define Self-Contained cv_catboost_leakfree_reg Engine (Rule 4)\n","    # =========================================================================\n","    def cv_catboost_leakfree_reg(\n","        df_subset: pd.DataFrame,\n","        feature_cols: list,\n","        target_col: str,\n","        params: dict = None,\n","        n_splits: int = 5,\n","        gap: int = 50,\n","        early_stopping_rounds: int = 30,\n","        verbose: bool = False\n","    ) -> dict:\n","        \"\"\"\n","        Self-contained, leak-free Walk-Forward Cross-Validation engine for CatBoost Regressors.\n","        Guarantees fold-local scaling and inner early-stopping splits with zero cross-contamination.\n","        \"\"\"\n","        if params is None:\n","            params = {\n","                'iterations': 1000,\n","                'learning_rate': 0.03,\n","                'depth': 6,\n","                'loss_function': 'RMSE',\n","                'eval_metric': 'RMSE',\n","                'random_seed': 42,\n","                'thread_count': -1\n","            }\n","        else:\n","            params = copy.deepcopy(params)\n","            params['thread_count'] = -1  # Maximize CPU core saturation\n","\n","        cols_needed = list(set(['checked_at_utc'] + feature_cols + [target_col]))\n","        df_clean = df_subset[cols_needed].replace([np.inf, -np.inf], np.nan).dropna()\n","        if 'checked_at_utc' in df_clean.columns:\n","            df_clean = df_clean.sort_values('checked_at_utc').reset_index(drop=True)\n","        else:\n","            df_clean = df_clean.reset_index(drop=True)\n","\n","        tscv = TimeSeriesSplit(n_splits=n_splits, gap=gap)\n","        scores = {'r2': [], 'spearman_rho': [], 'rmse': [], 'mae': [], 'best_n': []}\n","        fold_details = []\n","\n","        for fold, (train_idx, test_idx) in enumerate(tscv.split(df_clean)):\n","            df_fold_tr = df_clean.iloc[train_idx].reset_index(drop=True)\n","            df_fold_te = df_clean.iloc[test_idx].reset_index(drop=True)\n","\n","            sub_tr_size = int(len(df_fold_tr) * 0.85)\n","            df_sub_tr  = df_fold_tr.iloc[:sub_tr_size].reset_index(drop=True)\n","            df_sub_val = df_fold_tr.iloc[sub_tr_size:].reset_index(drop=True)\n","\n","            # Fold-local scaling\n","            scaler = StandardScaler()\n","            X_sub_tr_sc  = scaler.fit_transform(df_sub_tr[feature_cols].values.astype(np.float32))\n","            X_sub_val_sc = scaler.transform(df_sub_val[feature_cols].values.astype(np.float32))\n","            X_test_sc    = scaler.transform(df_fold_te[feature_cols].values.astype(np.float32))\n","\n","            y_sub_tr  = df_sub_tr[target_col].values.astype(np.float32)\n","            y_sub_val = df_sub_val[target_col].values.astype(np.float32)\n","            y_test    = df_fold_te[target_col].values.astype(np.float32)\n","\n","            cb_model = CatBoostRegressor(\n","                **params,\n","                early_stopping_rounds=early_stopping_rounds,\n","                verbose=False\n","            )\n","            cb_model.fit(X_sub_tr_sc, y_sub_tr, eval_set=(X_sub_val_sc, y_sub_val), verbose=False)\n","            best_iter = cb_model.get_best_iteration()\n","\n","            y_pred_test = cb_model.predict(X_test_sc)\n","\n","            fold_r2   = float(r2_score(y_test, y_pred_test))\n","            fold_rho  = float(spearmanr(y_test, y_pred_test)[0]) if len(np.unique(y_test)) > 1 else 0.0\n","            fold_rmse = float(np.sqrt(mean_squared_error(y_test, y_pred_test)))\n","            fold_mae  = float(mean_absolute_error(y_test, y_pred_test))\n","\n","            scores['r2'].append(fold_r2)\n","            scores['spearman_rho'].append(fold_rho)\n","            scores['rmse'].append(fold_rmse)\n","            scores['mae'].append(fold_mae)\n","            scores['best_n'].append(best_iter)\n","\n","            fold_details.append({\n","                'fold': fold + 1,\n","                'train_size': len(df_sub_tr),\n","                'val_size': len(df_sub_val),\n","                'test_size': len(df_fold_te),\n","                'best_iter': best_iter,\n","                'test_r2': round(fold_r2, 5),\n","                'test_spearman_rho': round(fold_rho, 5),\n","                'test_rmse': round(fold_rmse, 4)\n","            })\n","\n","            if verbose:\n","                print(f\"    [Fold {fold+1}/{n_splits}] Best Iter: {best_iter:3d} | R^2: {fold_r2:+.4f} | Rho: {fold_rho:+.4f} | RMSE: {fold_rmse:.2f}%\")\n","\n","        result = {k: (float(np.mean(v)), float(np.std(v))) for k, v in scores.items() if k != 'best_n'}\n","        result['best_n_per_fold'] = scores['best_n']\n","        result['best_n_mean']     = float(np.mean(scores['best_n'])) if len(scores['best_n']) > 0 else 0.0\n","        result['fold_details']    = fold_details\n","        result['n_splits_run']    = len(scores['r2'])\n","        return result\n","\n","    print(\"--- [Engine Initialized] cv_catboost_leakfree_reg loaded self-containedly ---\")\n","\n","    # =========================================================================\n","    # STEP 3: Directional Target-Specific True Tree SHAP-16 Extraction\n","    # =========================================================================\n","    print(\"\\n--- Step 3: Extracting 4 Dedicated True Tree SHAP-16 Sets on Sub-Train ---\")\n","    shap_features_map = {}\n","\n","    for t_col in REGRESSION_TARGETS:\n","        shap_features_map[t_col] = {}\n","        for dir_val in DIRECTIONS:\n","            df_tr_dir, feats_all_dir = direction_train_map[dir_val]\n","\n","            clean_tr = df_tr_dir[['checked_at_utc', t_col] + feats_all_dir].replace([np.inf, -np.inf], np.nan).dropna().sort_values('checked_at_utc').reset_index(drop=True)\n","            sub_size = int(len(clean_tr) * 0.85)\n","            df_sub   = clean_tr.iloc[:sub_size].reset_index(drop=True)\n","\n","            lgb_reg = lgb.LGBMRegressor(n_estimators=100, learning_rate=0.05, random_state=42, verbose=-1, n_jobs=-1)\n","            lgb_reg.fit(df_sub[feats_all_dir], df_sub[t_col])\n","\n","            exp = shap.TreeExplainer(lgb_reg)\n","            s_matrix = exp.shap_values(df_sub[feats_all_dir])\n","\n","            mean_shap = np.abs(s_matrix).mean(axis=0)\n","            s_ranks   = pd.Series(mean_shap, index=feats_all_dir).sort_values(ascending=False)\n","            top16     = list(s_ranks.head(16).index)\n","\n","            shap_features_map[t_col][dir_val] = top16\n","            print(f\"  [{t_col:<17} | {dir_val:<5}] Top 3 SHAP: {top16[:3]}\")\n","\n","    print(\"All 4 Target-Specific SHAP-16 Feature Sets Extracted.\\n\")\n","\n","    # =========================================================================\n","    # STEP 4: Tier 1 — 4 Global Directional Models (50-Trial Optuna)\n","    # =========================================================================\n","    print(f\"--- Step 4: Tier 1 — Optimizing 4 Global Directional Models ({N_OPTUNA_TRIALS} Trials each) ---\")\n","    \n","    global_model_summaries = []\n","    global_winning_params  = {}\n","    t_tier1_start = time.perf_counter()\n","\n","    for t_col in REGRESSION_TARGETS:\n","        for dir_val in DIRECTIONS:\n","            combo_key = f\"{t_col}__{dir_val}__GLOBAL\"\n","            t_start   = time.perf_counter()\n","            df_tr_dir, _  = direction_train_map[dir_val]\n","            df_oos_dir, _ = direction_oos_map[dir_val]\n","            f_s16 = shap_features_map[t_col][dir_val]\n","\n","            print(f\"\\n[Global Optuna Study] Target: {t_col} | Direction: {dir_val} ({N_OPTUNA_TRIALS} Trials)\")\n","\n","            # Optuna Objective Function for Global Slice\n","            def objective(trial):\n","                p = {\n","                    'iterations': 1000,\n","                    'depth': trial.suggest_int('depth', 4, 8),\n","                    'learning_rate': trial.suggest_float('learning_rate', 0.015, 0.08, log=True),\n","                    'l2_leaf_reg': trial.suggest_float('l2_leaf_reg', 1.0, 15.0, log=True),\n","                    'random_strength': trial.suggest_float('random_strength', 0.2, 2.0),\n","                    'bagging_temperature': trial.suggest_float('bagging_temperature', 0.0, 1.0),\n","                    'loss_function': 'RMSE',\n","                    'eval_metric': 'RMSE',\n","                    'random_seed': 42,\n","                    'thread_count': -1\n","                }\n","\n","                cv_res = cv_catboost_leakfree_reg(\n","                    df_subset=df_tr_dir,\n","                    feature_cols=f_s16,\n","                    target_col=t_col,\n","                    params=p,\n","                    n_splits=5,\n","                    gap=50,\n","                    early_stopping_rounds=30,\n","                    verbose=False\n","                )\n","                # Maximize CV R^2 + 0.5 * Spearman rho balance\n","                return cv_res['r2'][0] + 0.5 * cv_res['spearman_rho'][0]\n","\n","            study = optuna.create_study(direction='maximize', sampler=optuna.samplers.TPESampler(seed=42))\n","            study.optimize(objective, n_trials=N_OPTUNA_TRIALS, timeout=900)\n","            best_p = study.best_params\n","\n","            global_winning_params[f\"{t_col}__{dir_val}\"] = best_p\n","\n","            # Retrain final Global model on pooled Sub-Train with Sub-Val early stopping\n","            clean_tr  = df_tr_dir[['checked_at_utc', t_col] + f_s16].replace([np.inf, -np.inf], np.nan).dropna().sort_values('checked_at_utc').reset_index(drop=True)\n","            clean_oos = df_oos_dir[['checked_at_utc', t_col] + f_s16].replace([np.inf, -np.inf], np.nan).dropna().sort_values('checked_at_utc').reset_index(drop=True)\n","\n","            sub_size  = int(len(clean_tr) * 0.85)\n","            df_sub_tr = clean_tr.iloc[:sub_size].reset_index(drop=True)\n","            df_sub_val= clean_tr.iloc[sub_size:].reset_index(drop=True)\n","\n","            scaler_g = StandardScaler()\n","            X_tr_sc  = scaler_g.fit_transform(df_sub_tr[f_s16].values.astype(np.float32))\n","            X_val_sc = scaler_g.transform(df_sub_val[f_s16].values.astype(np.float32))\n","            X_oos_sc = scaler_g.transform(clean_oos[f_s16].values.astype(np.float32))\n","\n","            y_tr  = df_sub_tr[t_col].values.astype(np.float32)\n","            y_val = df_sub_val[t_col].values.astype(np.float32)\n","            y_oos = clean_oos[t_col].values.astype(np.float32)\n","\n","            global_model = CatBoostRegressor(\n","                iterations=1000,\n","                depth=best_p['depth'],\n","                learning_rate=best_p['learning_rate'],\n","                l2_leaf_reg=best_p['l2_leaf_reg'],\n","                random_strength=best_p['random_strength'],\n","                bagging_temperature=best_p['bagging_temperature'],\n","                loss_function='RMSE',\n","                eval_metric='RMSE',\n","                random_seed=42,\n","                early_stopping_rounds=30,\n","                thread_count=-1,\n","                verbose=False\n","            )\n","            global_model.fit(X_tr_sc, y_tr, eval_set=(X_val_sc, y_val), verbose=False)\n","            best_iter = global_model.get_best_iteration()\n","\n","            # Save model checkpoint\n","            model_filename = f\"Ema_testnet_CatBoostRegressor_{t_col}_{dir_val}_GLOBAL_models.cbm\"\n","            model_path     = os.path.join(MODELS_DIR, model_filename)\n","            global_model.save_model(model_path)\n","\n","            # Evaluate on untouched OOS\n","            y_pred_oos = global_model.predict(X_oos_sc)\n","            oos_r2   = float(r2_score(y_oos, y_pred_oos))\n","            oos_rho  = float(spearmanr(y_oos, y_pred_oos)[0]) if len(np.unique(y_oos)) > 1 else 0.0\n","            oos_rmse = float(np.sqrt(mean_squared_error(y_oos, y_pred_oos)))\n","            oos_mae  = float(mean_absolute_error(y_oos, y_pred_oos))\n","\n","            elapsed = time.perf_counter() - t_start\n","\n","            record = {\n","                'tier': 'Global Baseline',\n","                'target': t_col,\n","                'direction': dir_val,\n","                'symbol': 'GLOBAL',\n","                'depth': best_p['depth'],\n","                'learning_rate': round(best_p['learning_rate'], 4),\n","                'l2_leaf_reg': round(best_p['l2_leaf_reg'], 2),\n","                'best_iteration': best_iter,\n","                'oos_samples': len(y_oos),\n","                'oos_r2': round(oos_r2, 4),\n","                'oos_spearman_rho': round(oos_rho, 4),\n","                'oos_rmse': round(oos_rmse, 3),\n","                'oos_mae': round(oos_mae, 3),\n","                'checkpoint_file': model_filename\n","            }\n","            global_model_summaries.append(record)\n","            print(f\"  --> Global {t_col} ({dir_val}) | Optuna EI: {study.best_value:.4f} | OOS R^2: {oos_r2:+.4f} | Rho: {oos_rho:+.4f} | Checkpoint: {model_filename} ({elapsed:.1f}s)\")\n","\n","    print(f\"\\nTier 1 Complete in {time.perf_counter() - t_tier1_start:.1f}s. All 4 Global Models Checkpointed.\\n\")\n","\n","    # =========================================================================\n","    # STEP 5: Tier 2 — 20 Per-Symbol Models (50-Trial Optuna per Coin)\n","    # =========================================================================\n","    print(f\"--- Step 5: Tier 2 — Optimizing 20 Per-Symbol Models ({N_OPTUNA_TRIALS} Trials each) ---\")\n","    \n","    symbol_model_summaries = []\n","    symbol_models_registry = {}\n","    model_counter = 4\n","    t_tier2_start = time.perf_counter()\n","\n","    for t_col in REGRESSION_TARGETS:\n","        for dir_val in DIRECTIONS:\n","            df_tr_dir, _  = direction_train_map[dir_val]\n","            df_oos_dir, _ = direction_oos_map[dir_val]\n","            f_s16 = shap_features_map[t_col][dir_val]\n","\n","            for sym in ACTIVE_SYMBOLS:\n","                model_counter += 1\n","                inst_key = f\"{t_col}__{dir_val}__{sym}\"\n","                t_sym_start = time.perf_counter()\n","\n","                cols_needed = list(set(['checked_at_utc', t_col] + f_s16))\n","                df_sym_tr  = df_tr_dir[df_tr_dir['symbol'] == sym][cols_needed].replace([np.inf, -np.inf], np.nan).dropna().sort_values('checked_at_utc').reset_index(drop=True)\n","                df_sym_oos = df_oos_dir[df_oos_dir['symbol'] == sym][cols_needed].replace([np.inf, -np.inf], np.nan).dropna().sort_values('checked_at_utc').reset_index(drop=True)\n","\n","                if len(df_sym_tr) < 50 or len(df_sym_oos) < 10:\n","                    print(f\"  [{model_counter:2d}/24] Skipped {inst_key}: Insufficient samples.\")\n","                    continue\n","\n","                def symbol_objective(trial):\n","                    p = {\n","                        'iterations': 1000,\n","                        'depth': trial.suggest_int('depth', 4, 8),\n","                        'learning_rate': trial.suggest_float('learning_rate', 0.015, 0.08, log=True),\n","                        'l2_leaf_reg': trial.suggest_float('l2_leaf_reg', 1.0, 15.0, log=True),\n","                        'random_strength': trial.suggest_float('random_strength', 0.2, 2.0),\n","                        'bagging_temperature': trial.suggest_float('bagging_temperature', 0.0, 1.0),\n","                        'loss_function': 'RMSE',\n","                        'eval_metric': 'RMSE',\n","                        'random_seed': 42,\n","                        'thread_count': -1\n","                    }\n","                    cv_res = cv_catboost_leakfree_reg(\n","                        df_subset=df_sym_tr,\n","                        feature_cols=f_s16,\n","                        target_col=t_col,\n","                        params=p,\n","                        n_splits=5,\n","                        gap=50,\n","                        early_stopping_rounds=30,\n","                        verbose=False\n","                    )\n","                    return cv_res['r2'][0] + 0.5 * cv_res['spearman_rho'][0]\n","\n","                study_sym = optuna.create_study(direction='maximize', sampler=optuna.samplers.TPESampler(seed=42))\n","                study_sym.optimize(symbol_objective, n_trials=N_OPTUNA_TRIALS, timeout=300)\n","                best_sym_p = study_sym.best_params\n","\n","                # Retrain production model on symbol Sub-Train with Sub-Val early stopping\n","                sub_size   = int(len(df_sym_tr) * 0.85)\n","                df_sub_tr  = df_sym_tr.iloc[:sub_size].reset_index(drop=True)\n","                df_sub_val = df_sym_tr.iloc[sub_size:].reset_index(drop=True)\n","\n","                scaler_s = StandardScaler()\n","                X_tr_sc  = scaler_s.fit_transform(df_sub_tr[f_s16].values.astype(np.float32))\n","                X_val_sc = scaler_s.transform(df_sub_val[f_s16].values.astype(np.float32))\n","                X_oos_sc = scaler_s.transform(df_sym_oos[f_s16].values.astype(np.float32))\n","\n","                y_tr  = df_sub_tr[t_col].values.astype(np.float32)\n","                y_val = df_sub_val[t_col].values.astype(np.float32)\n","                y_oos = df_sym_oos[t_col].values.astype(np.float32)\n","\n","                sym_model = CatBoostRegressor(\n","                    iterations=1000,\n","                    depth=best_sym_p['depth'],\n","                    learning_rate=best_sym_p['learning_rate'],\n","                    l2_leaf_reg=best_sym_p['l2_leaf_reg'],\n","                    random_strength=best_sym_p['random_strength'],\n","                    bagging_temperature=best_sym_p['bagging_temperature'],\n","                    loss_function='RMSE',\n","                    eval_metric='RMSE',\n","                    random_seed=42,\n","                    early_stopping_rounds=30,\n","                    thread_count=-1,\n","                    verbose=False\n","                )\n","                sym_model.fit(X_tr_sc, y_tr, eval_set=(X_val_sc, y_val), verbose=False)\n","                best_iter = sym_model.get_best_iteration()\n","\n","                # Checkpoint to MODELS_DIR\n","                model_filename = f\"Ema_testnet_CatBoostRegressor_{t_col}_{dir_val}_{sym}_models.cbm\"\n","                model_path     = os.path.join(MODELS_DIR, model_filename)\n","                sym_model.save_model(model_path)\n","\n","                # Evaluate on untouched OOS\n","                y_pred_oos = sym_model.predict(X_oos_sc)\n","                oos_r2   = float(r2_score(y_oos, y_pred_oos))\n","                oos_rho  = float(spearmanr(y_oos, y_pred_oos)[0]) if len(np.unique(y_oos)) > 1 else 0.0\n","                oos_rmse = float(np.sqrt(mean_squared_error(y_oos, y_pred_oos)))\n","                oos_mae  = float(mean_absolute_error(y_oos, y_pred_oos))\n","\n","                elapsed_sym = time.perf_counter() - t_sym_start\n","\n","                record = {\n","                    'tier': 'Symbol-Specific',\n","                    'target': t_col,\n","                    'direction': dir_val,\n","                    'symbol': sym,\n","                    'depth': best_sym_p['depth'],\n","                    'learning_rate': round(best_sym_p['learning_rate'], 4),\n","                    'l2_leaf_reg': round(best_sym_p['l2_leaf_reg'], 2),\n","                    'best_iteration': best_iter,\n","                    'oos_samples': len(y_oos),\n","                    'oos_r2': round(oos_r2, 4),\n","                    'oos_spearman_rho': round(oos_rho, 4),\n","                    'oos_rmse': round(oos_rmse, 3),\n","                    'oos_mae': round(oos_mae, 3),\n","                    'checkpoint_file': model_filename\n","                }\n","                symbol_models_registry[inst_key] = record\n","                symbol_model_summaries.append(record)\n","\n","                print(f\"  [{model_counter:2d}/24] {t_col:<17} | {dir_val:<5} | {sym:<8} -> Depth: {best_sym_p['depth']} | LR: {best_sym_p['learning_rate']:.4f} | L2: {best_sym_p['l2_leaf_reg']:.2f} | OOS R^2: {oos_r2:+.4f} | Rho: {oos_rho:+.4f} ({elapsed_sym:.1f}s)\")\n","\n","    total_duration = time.perf_counter() - t_tier1_start\n","    print(f\"\\nAll 24 Models Optimized and Checkpointed in {total_duration/60:.2f} minutes.\\n\")\n","\n","    # =========================================================================\n","    # STEP 6: Master 24-Model Scoreboard, Visual Diagnostics & JSON Serialization\n","    # =========================================================================\n","    master_24_df = pd.concat([\n","        pd.DataFrame(global_model_summaries),\n","        pd.DataFrame(symbol_model_summaries)\n","    ], ignore_index=True)\n","\n","    print(\"=============================================================================================================================\")\n","    print(\"                 MASTER 24-MODEL CATBOOST REGRESSION SCOREBOARD (4 GLOBAL + 20 SYMBOL MODELS)                                 \")\n","    print(\"======================================================